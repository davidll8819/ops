NODE_ENV=development
APP_ORIGIN=http://localhost:3000
AUTH_MODE=cognito
AWS_PROFILE=0511
AWS_REGION=ap-east-1
AGENT_REGION=us-west-2
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:56379
AGENT_HARNESS_ARN=
AGENT_STATELESS_HARNESS_ARN=
AGENT_EXECUTION_ROLE_ARN=
AGENT_MEMORY_ARN=
ALLOWED_MODEL_IDS=
BUILDER_MODEL_ID=
MODEL_RATES_JSON={}

# Private files; never commit keys or tenant runtime credentials.
OPERATIONS_CONFIG_KEY_FILE=.local/operations-config.key
OPERATIONS_RUNTIMES_FILE=.local/operations-runtimes.json

# Single-company LOCAL gateway binding. Never share these keys across companies.
# For multi-tenant servers use TENANT_<UPPERCASE_UUID_WITHOUT_HYPHENS>_RELAY_API_KEY
# and TENANT_<UPPERCASE_UUID_WITHOUT_HYPHENS>_AITOEARN_RELAY_KEY instead.
GATEWAY_TENANT_ID=
RELAY_API_KEY=
AITOEARN_RELAY_KEY=

# Dragon's isolated local project worker. Build apps/execution/Dockerfile first.
EXECUTION_ENABLED=false
EXECUTION_IMAGE=wishtaday-execution:local
# Optional Docker CLI path; never a model-controlled value.
EXECUTION_DOCKER=
